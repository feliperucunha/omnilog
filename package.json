{
  "name": "geeklogs",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "heroku-build": "pnpm exec turbo run build --filter=@geeklogs/api...",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "start": "node apps/api/dist/index.js",
    "start:api": "node apps/api/dist/index.js",
    "build:android": "pnpm --filter @geeklogs/web build:android",
    "android": "pnpm --filter @geeklogs/android android",
    "ios": "pnpm --filter @geeklogs/android ios"
  },
  "dependencies": {
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=18"
  }
}
