{
  "name": "@geeklogs/android",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync": "cap sync",
    "sync:android": "cap sync android",
    "sync:ios": "cap sync ios",
    "open": "cap open android",
    "open:ios": "cap open ios",
    "build": "pnpm --filter @geeklogs/web build:android && cap sync",
    "android": "pnpm --filter @geeklogs/web build:android && cap sync android && cap open android",
    "ios": "pnpm --filter @geeklogs/web build:android && cap sync ios && cap open ios"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capgo/capacitor-native-biometric": "7.6.0",
    "@geeklogs/web": "workspace:*"
  },
  "capacitor": {
    "platforms": [
      "android",
      "ios"
    ]
  }
}
