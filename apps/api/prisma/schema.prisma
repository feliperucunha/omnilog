generator client {
  provider = "prisma-client-js"
}

// When using a transaction-mode pooler (e.g. Supabase pooler :6543, PgBouncer),
// add ?pgbouncer=true to DATABASE_URL (or &pgbouncer=true if URL has other params).
// Otherwise you get: "prepared statement \"s20\" does not exist" in production.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  free
  beta
  pro
  admin
}

enum BadgeMedium {
  MOVIE
  TV_SHOW
  ANIME
  MANGA
  COMIC
  BOOK
  GAME
  BOARD_GAME
}

enum BadgeRarity {
  common
  rare
  epic
  legendary
}

enum BadgeConditionType {
  FIRST_REVIEW
  REVIEW_COUNT_PER_MEDIA
  REVIEW_COUNT_GLOBAL
  MEDIA_TYPES_REVIEWED
  REVIEW_LIKES
  REVIEW_STREAK
  LOG_COUNT_PER_MEDIA
  LOG_COUNT_GLOBAL
  LOG_MEDIA_TYPES_LOGGED
}

model User {
  id                   String    @id @default(cuid())
  username             String?   @unique
  email                String    @unique
  password             String
  passwordResetToken   String?   // unique token for reset link
  passwordResetExpires DateTime? // token expiry (e.g. 1h)
  tmdbApiKey       String?
  rawgApiKey       String?
  bggApiToken        String?
  ludopediaApiToken  String?
  comicVineApiKey    String?
  preferredTheme       String?  // "light" | "dark"
  preferredLocale      String?  // "en" | "pt-BR" | "es"
  recapEmailsEnabled   Boolean  @default(true) // monthly activity digest email
  visibleMediaTypes    String?  // JSON array of media type strings; null = all
  profileVisibility    String?  // JSON ProfileVisibility; null = all public defaults
  boardGameProvider   String?  // "bgg" | "ludopedia"; null = bgg
  tier                Tier     @default(free)
  stripeSubscriptionId  String?  @unique // Stripe subscription ID for Pro
  stripeCustomerId     String?  // Stripe customer ID (for billing portal)
  /// Google Play subscription purchase token (Android); verified server-side; unique per purchase
  googlePlayPurchaseToken String? @unique
  /// Base product id from Play (e.g. geeklogs_pro_yearly); used for manage-subscription deep link
  googlePlayProductId    String?
  subscriptionEndsAt   DateTime?       // Pro access until this date; cron clears tier when past; null = endless (e.g. testing)
  subscriptionCancelAtPeriodEnd Boolean @default(false) // true after user cancels; access continues until subscriptionEndsAt
  subscriptionInterval String?          // "monthly" | "yearly"; current Stripe subscription cadence
  country             String?  // ISO 3166-1 alpha-2 e.g. BR for pricing
  defaultPurchaseCurrency String? // ISO 4217; last currency used when saving a purchase amount
  onboarded           Boolean  @default(false)
  currentStreak       Int      @default(0)
  lastReviewDate      DateTime?
  selectedBadgeIds    String?  // JSON array of up to 3 badge IDs for profile display
  loginCount          Int      @default(0)  // number of times the user has logged in
  lastLoginAt         DateTime?            // last login timestamp
  /// Last time a board-game collection import was started (24h cooldown between imports).
  lastBoardGameCollectionImportAt DateTime?
  createdAt           DateTime @default(now())
  updatedAt      DateTime @updatedAt
  logs          Log[]
  logReactions  LogReaction[]
  feedbacks      Feedback[]
  followsFollowing  Follow[] @relation("FollowFollowing")
  followsFollowers  Follow[] @relation("FollowFollower")
  userBadges     UserBadge[]
  reviewStats    UserReviewStats?
  /// Saved custom opponent names for board-game match logging (autocomplete).
  boardGameCustomOpponents UserBoardGameCustomOpponent[]
}

/// Per-user saved display names for board-game match players (non–app-user opponents).
model UserBoardGameCustomOpponent {
  id         String   @id @default(cuid())
  userId     String
  label      String
  /// Lowercase trimmed label for deduping / search within the owner account.
  labelKey   String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, labelKey])
  @@index([userId, lastUsedAt])
}

model Badge {
  id              String             @id @default(cuid())
  name            String
  description     String
  icon            String
  medium          BadgeMedium?
  rarity          BadgeRarity        @default(common)
  conditionType   BadgeConditionType
  conditionValue  Int
  hidden          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  userBadges      UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Milestone {
  id        String       @id @default(cuid())
  metric    String       // "reviews" | "logs"
  scope     String       // "global" | "per_medium"
  medium    BadgeMedium? // null when scope = global
  threshold Int
  label     String
  icon      String
  sortOrder Int          @default(0) // for stable ordering

  @@unique([metric, scope, medium, threshold])
  @@index([metric, scope])
}

model UserReviewStats {
  userId                 String   @id
  movieReviews           Int      @default(0)
  tvShowReviews          Int      @default(0)
  animeReviews           Int      @default(0)
  mangaReviews           Int      @default(0)
  comicReviews           Int      @default(0)
  bookReviews            Int      @default(0)
  gameReviews            Int      @default(0)
  boardGameReviews       Int      @default(0)
  totalReviews           Int      @default(0)
  distinctMediaReviewed  Int      @default(0)
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-10
  comments  String?  // optional text
  createdAt DateTime @default(now())

  @@index([userId])
}

model Log {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaType  String
  externalId String
  title      String
  image      String?  // poster/cover URL saved when logging (for cards and item page fallback)
  grade      Int?     // null when only in list without review
  review     String?  // optional comment (sanitized before save)
  listType   String?  // legacy "favorites" | "pending"
  status       String?   // per-media: watched, completed, playing, etc.
  startedAt    DateTime? // when set to in-progress (watching/reading/playing)
  completedAt  DateTime? // when set to completed
  contentHours Float?   // duration of content in hours (for stats)
  hoursToBeat  Float?  // games only: how long it took the user to beat (hours)
  gamePlatform String? // games only: console / platform the user is playing on
  season       Int?     // tv, anime
  episode      Int?     // tv, anime
  chapter      Int?     // anime, manga, comics
  volume       Int?     // anime, manga, comics
  pagesRead    Int?     // books, manga, comics: current page progress
  boardGameSource String?  // "bgg" | "ludopedia" when mediaType = boardgames; which API this externalId came from
  own            Boolean? // games, board games, books, manga, comics: user owns a copy
  wantToBuy      Boolean? // same categories: user wants to buy a copy
  /// User sold / no longer has the item; optional sale proceeds in saleAmountMinor + saleCurrency
  sold           Boolean?
  matchesPlayed  Int?     // boardgames only: number of matches/sessions played
  genres         String?  // JSON array of genre names (for stats and badges)
  mechanics       String?  // JSON array of board-game mechanic names (BGG / Ludopedia); optional
  affinityContext String?  // JSON: recommendation snapshot (board stats, book subjects, manga themes, …)
  // purchaseAmountMinor + purchaseCurrency: optional cost (minor units + ISO 4217); kept when sold alongside sale* for net P&L
  purchaseAmountMinor Int?
  purchaseCurrency    String?
  // Sale proceeds when sold=true (same minor-unit + ISO 4217 convention as purchase)
  saleAmountMinor Int?
  saleCurrency    String?
  /// When purchase/sale amounts were last set or changed (statistics “this month/year” use this instead of createdAt).
  spendFieldsAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reactions        LogReaction[]
  boardGameMatches BoardGameMatch[]
  scopedReviews    ScopedReview[]

  @@unique([userId, mediaType, externalId])
  @@index([userId])
  @@index([userId, mediaType])
  @@index([userId, updatedAt])
  @@index([mediaType, externalId])
}

model LogReaction {
  id        String   @id @default(cuid())
  logId     String
  userId    String
  type      String   // "like" | "dislike"
  createdAt DateTime @default(now())
  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, logId])
  @@index([logId])
  @@index([userId])
}

/// TV/anime: optional per-show, per-season, or per-episode rating and review (series progress stays on Log).
model ScopedReview {
  id         String   @id @default(cuid())
  logId      String
  log        Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  scope      String
  seasonNum  Int      @default(0)
  episodeNum Int      @default(0)
  grade      Int?
  review     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([logId, scope, seasonNum, episodeNum])
  @@index([logId])
}

/// Board games only: one play session with players, scores, optional session notes (not the main log review).
model BoardGameMatch {
  id        String   @id @default(cuid())
  logId     String
  log       Log      @relation(fields: [logId], references: [id], onDelete: Cascade)
  playedAt  DateTime
  /// JSON: [{ "name": string, "score": number | null, "winner": boolean }]
  players   String
  notes     String?
  createdAt DateTime @default(now())

  @@index([logId])
  @@index([logId, playedAt])
}

/// App-wide toggles (e.g. relax API-key UX). Editable via admin API only.
model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Simple key/value settings edited via admin UI (e.g. announcement text).
model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

/// Processed Stripe webhook `event.id` values — claim-before-handling for idempotency (retries safe).
model StripeWebhookEvent {
  id             String   @id @default(cuid())
  stripeEventId  String   @unique
  createdAt      DateTime @default(now())
}

/// Processed Google Play RTDN Pub/Sub `message.messageId` — idempotency for push retries.
model GooglePlayPubSubMessage {
  id         String   @id @default(cuid())
  messageId  String   @unique
  createdAt  DateTime @default(now())
}

/// Lazily populated cache of upstream item-detail fields used to enrich `Log` rows on read
/// (e.g. dashboard badges). Composite key (mediaType, externalId) covers TMDB tv/movies,
/// Jikan anime/manga, and RAWG games without bloating the Log table or blocking writes
/// on an upstream API call. tv-only fields (`networks`, `status`) stay null for other types.
model ItemDetailCache {
  mediaType  String
  externalId String
  score      Float?                 // Normalized 0-10 rating from the upstream API
  networks   String?                // tv/movies/anime: JSON-encoded string[] (networks or streaming providers)
  status     String?                // tv only: raw TMDB status (e.g. "Ended", "Returning Series")
  pagesCount Int?                   // books only: representative page count (median across editions)
  playersMin Int?                   // boardgames only: min players from BGG / Ludopedia
  playersMax Int?                   // boardgames only: max players from BGG / Ludopedia
  fetchedAt  DateTime @default(now()) @updatedAt

  @@id([mediaType, externalId])
}

model SearchResponseCache {
  mediaType String
  queryKey  String
  payload   Json
  fetchedAt DateTime @default(now()) @updatedAt

  @@id([mediaType, queryKey])
}

model ItemPayloadCache {
  mediaType  String
  externalId String
  payload    Json
  fetchedAt  DateTime @default(now()) @updatedAt

  @@id([mediaType, externalId])
}

