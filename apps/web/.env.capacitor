# Used when building for Capacitor/Android (vite build --mode capacitor).
# The app will request https://vague-elysha-omnilog-41994d8d.koyeb.app/api
VITE_API_URL=https://vague-elysha-omnilog-41994d8d.koyeb.app/api
# Public web origin (same host as Android app_link_host) for deep links and in-app HTTPS handling.
VITE_APP_WEB_ORIGIN=https://geeklogs.vercel.app
# Google Play subscriptions — must match Play Console and API GOOGLE_PLAY_SUBSCRIPTION_ID_*.
# VITE_ANDROID_PACKAGE_ID=com.geeklogs.app
# VITE_GOOGLE_PLAY_PRODUCT_MONTHLY=geeklogs_pro_monthly
# VITE_GOOGLE_PLAY_PRODUCT_YEARLY=geeklogs_pro_yearly
